# Copy to .env and fill in. On Vercel, add the same names under Settings > Environment Variables.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model to use (default gemini-3.8-flash)
GEMINI_MODEL=

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional. Locks the bot to Meera's Telegram user id. If empty, the first person
# to message the bot becomes its only allowed user.
TELEGRAM_ALLOWED_USER_ID=

# Vercel only. Created in .env by `python set_webhook.py <url>`; copy the same value into Vercel.
TELEGRAM_WEBHOOK_SECRET=

# Supabase (Project Settings > API). Required on Vercel. If set locally, bot.py uses Supabase too;
# if empty, bot.py uses the local SQLite file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
