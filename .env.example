# Copy to .env and fill in.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model to use (default gemini-3.8-flash)
GEMINI_MODEL=

# From @BotFather. Add the bot to Meera's notes channel as an admin.
TELEGRAM_BOT_TOKEN=

# Optional. Locks the bot to Meera's Telegram user id. If empty, the first person
# to message the bot becomes its only allowed user.
TELEGRAM_ALLOWED_USER_ID=

# Only used by the older batch mode (drafter.py), not by bot.py.
TELEGRAM_CHANNEL_ID=
TELEGRAM_REVIEW_CHAT_ID=
